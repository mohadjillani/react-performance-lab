{
  "name": "react-performance-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately slow Next.js course catalogue and five cumulative fix branches, each measured the same way: size-limit for bundles, Lighthouse CI for Core Web Vitals.",
  "keywords": [
    "react",
    "nextjs",
    "performance",
    "core-web-vitals",
    "lighthouse",
    "size-limit",
    "playwright",
    "typescript"
  ],
  "author": "Mohad Jillani <mohad.jillani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohadjillani/react-performance-lab.git"
  },
  "homepage": "https://github.com/mohadjillani/react-performance-lab#readme",
  "bugs": "https://github.com/mohadjillani/react-performance-lab/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.0.8",
    "react-dom": "^19.0.8"
  },
  "devDependencies": {
