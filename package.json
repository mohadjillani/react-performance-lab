{
  "name": "react-performance-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately slow Next.js course catalogue and five cumulative fix branches, each measured the same way: size-limit for bundles, Lighthouse CI for Core Web Vitals.",
  "keywords": [
    "react",
    "nextjs",
    "performance",
    "core-web-vitals",
    "lighthouse",
    "size-limit",
    "playwright",
    "typescript"
  ],
  "author": "Mohad Jillani <mohad.jillani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohadjillani/react-performance-lab.git"
  },
  "homepage": "https://github.com/mohadjillani/react-performance-lab#readme",
  "bugs": "https://github.com/mohadjillani/react-performance-lab/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "analyze": "ANALYZE=true next build && tsx scripts/analyze-summary.ts --out docs/profile-first/client-summary.json",
    "size": "tsx scripts/route-bundles.ts && size-limit",
    "measure": "tsx scripts/measure.ts",
    "test:e2e": "playwright test",
    "compare": "tsx scripts/compare.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "moment": "^2.30.1",
    "next": "^15.5.24",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.3",
    "@next/eslint-plugin-next": "^15.5.24",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^11.2.0",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "size-limit": "^11.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
